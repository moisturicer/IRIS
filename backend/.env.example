DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=iris_db
DB_USER=iris_user
DB_PASSWORD=iris_password
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# AI
ANTHROPIC_API_KEY=your-anthropic-key
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Docling-serve (on-prem structured PDF extraction). The Compose files set
# this to the service name; override only when running Django outside Compose.
DOCLING_API_URL=http://localhost:5001
DOCLING_TIMEOUT_SECONDS=600

# Chunking (ADR-013). These are the defaults every ingestion run inherits.
# The ceiling is a prior, not a decision: IR-116 settles it by reading real
# chunks (manage.py inspect_chunks). AI_CHUNK_MIN_TOKENS blank means "derive
# it from the ceiling".
# Blank uses the domain's registered default strategy. Set one only to pin a
# different registered id -- an unknown id raises rather than falling back.
AI_CHUNK_STRATEGY=
AI_CHUNK_MAX_TOKENS=512
AI_CHUNK_MIN_TOKENS=
AI_CHUNK_CONTEXT_PATH_MAX_TOKENS=48
AI_CHUNK_EXCLUDE_SECTIONS=References,Bibliography,Works Cited,Literature Cited

# Frontend
FRONTEND_URL=http://localhost:5173

# Django axes (brute force)
AXES_FAILURE_LIMIT=3
