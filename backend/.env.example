# This file documents every key and holds no real values (CLAUDE.md,
# Environment and secrets). Copy it to backend/.env and fill it in.
#
# The variables with no value below are REQUIRED: base.py reads them
# through required() and the process refuses to start when one is missing
# or blank, rather than falling back to a committed default (IR-154).

DEBUG=True

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated. Required by config.settings.production, which will not
# start on an empty value or on '*'.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. NAME, USER and PASSWORD are required and have no defaults.
# Under Compose these come from the repo-root .env instead, so that one
# file provisions Postgres and configures Django from the same values --
# see .env.example at the repository root.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# AI
# Model used for Ask IRIS synthesis. Provider choice is open decision D-4 —
# leaving the key unset keeps the pipeline in retrieval-only (extractive) mode.
# --- AI gateway (ADR-014 precondition 1, IR-156) ---
# Must equal the gateway's own SERVICE_SECRET in ai/.env. Django sends it
# as the x-iris-service-secret header; the gateway refuses every request
# without it (401), and refuses everything with 503 when its own copy is
# unset. Holds no real value here -- generate one per deployment:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_GATEWAY_SERVICE_SECRET=replace-me-with-a-generated-secret

AI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Docling-serve (on-prem structured PDF extraction). The Compose files set
# this to the service name; override only when running Django outside Compose.
DOCLING_API_URL=http://localhost:5001
DOCLING_TIMEOUT_SECONDS=600

# Chunking (ADR-013). These are the defaults every ingestion run inherits.
# The ceiling is a prior, not a decision: IR-116 settles it by reading real
# chunks (manage.py inspect_chunks). AI_CHUNK_MIN_TOKENS blank means "derive
# it from the ceiling".
# Blank uses the domain's registered default strategy. Set one only to pin a
# different registered id -- an unknown id raises rather than falling back.
# Django's cache (IR-132). Same Redis as Celery, different database number,
# so flushing a queue cannot take the query-embedding cache with it.
REDIS_CACHE_URL=redis://localhost:6379/1
CACHE_TIMEOUT_SECONDS=86400
# The vendor account's per-minute token budget, split between the ingestion and
# query lanes. The query lane gets the larger share -- a person is waiting on it.
AI_RATE_LIMIT_TOKENS_PER_MINUTE=1000000

# Inference provider (ADR-021). Groq for development, OpenRouter for
# production -- both speak the OpenAI chat format, so switching is these three
# values and no new code. Anthropic is not used.
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# A model id is a vendor's catalogue entry and they are withdrawn without
# notice -- llama-3.3-70b-versatile was the default here until Groq dropped
# it, and every call 404'd while the app still reported generative mode.
# Groq ids need the vendor prefix: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.8-27b. `GET {LLM_BASE_URL}/models` lists what a key can reach.
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1

# Voyage (ADR-015) -- embedding and reranking, one vendor for both stages.
# No default key and no local fallback: the adapter raises when it is absent
# rather than degrading silently. voyage-context-4 is 1024 dimensions, which
# must match the active EmbeddingSpace row or indexing and querying disagree.
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-context-4
VOYAGE_EMBED_DIMENSIONS=1024
VOYAGE_RERANK_MODEL=rerank-2
VOYAGE_TIMEOUT_SECONDS=60

AI_CHUNK_STRATEGY=
# NOTE THE UNIT: whitespace-delimited WORDS, not tokenizer tokens (IR-243).
# 512 words is roughly 44% more real BPE tokens than the number looks; the
# equivalent of docling-core's 512-token default is nearer 360.
AI_CHUNK_MAX_TOKENS=512
AI_CHUNK_MIN_TOKENS=
AI_CHUNK_CONTEXT_PATH_MAX_TOKENS=48
# Navigation indexes are excluded alongside the bibliography (IR-246): a
# table of contents carries every section name and none of their content.
# The title block is deliberately still chunked.
AI_CHUNK_EXCLUDE_SECTIONS=References,Bibliography,Works Cited,Literature Cited,Table of Contents,Contents,List of Tables,List of Figures

# Resubmission policy (ADR-004). 'clearance_aware' preserves every
# non-declining office's completed review -- the contribution, and the only
# correct value for a production instance. 'restart_all' resets them all and
# exists solely as the evaluation comparison arm.
#
# DO NOT set this to restart_all on an instance with real reviewers: it discards
# clearances they have already granted. The comparison runs on a dedicated,
# short-lived evaluation instance. An unrecognised value stops the app at
# startup rather than falling back, so a typo fails loudly instead of quietly
# running the wrong arm. Case does not matter: RESTART_ALL also works.
RESUBMISSION_POLICY=clearance_aware

# Frontend
FRONTEND_URL=http://localhost:5173

# Comma-separated CORS allowlist. Optional in development (it defaults to
# FRONTEND_URL); REQUIRED in production, where every entry must be https
# and there is no 'allow all' switch in any settings module.
# CORS_ALLOWED_ORIGINS=https://iris.cit.edu

# Django axes (brute force)
AXES_FAILURE_LIMIT=3
