# This file documents every key and holds no real values (CLAUDE.md,
# Environment and secrets). Copy it to backend/.env and fill it in.
#
# The variables with no value below are REQUIRED: base.py reads them
# through required() and the process refuses to start when one is missing
# or blank, rather than falling back to a committed default (IR-154).

DEBUG=True

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated. Required by config.settings.production, which will not
# start on an empty value or on '*'.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. NAME, USER and PASSWORD are required and have no defaults.
# Under Compose these come from the repo-root .env instead, so that one
# file provisions Postgres and configures Django from the same values --
# see .env.example at the repository root.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# AI
# Model used for Ask IRIS synthesis. Provider choice is open decision D-4 —
# leaving the key unset keeps the pipeline in retrieval-only (extractive) mode.
# --- AI gateway (ADR-014 precondition 1, IR-156) ---
# Must equal the gateway's own SERVICE_SECRET in ai/.env. Django sends it
# as the x-iris-service-secret header; the gateway refuses every request
# without it (401), and refuses everything with 503 when its own copy is
# unset. Holds no real value here -- generate one per deployment:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_GATEWAY_SERVICE_SECRET=replace-me-with-a-generated-secret

# Docling-serve (on-prem structured PDF extraction). The Compose files set
# this to the service name; override only when running Django outside Compose.
DOCLING_API_URL=http://localhost:5001
DOCLING_TIMEOUT_SECONDS=600
# IR-367. OCR is off by default: the corpus is born-digital (an exact text
# layer). Turn it on for scanned submissions -- one with no text layer produces
# nothing without it, and IRIS has no fallback extractor (ADR-016).
DOCLING_DO_OCR=false
DOCLING_DO_FORMULA_ENRICHMENT=true
DOCLING_DO_CODE_ENRICHMENT=true
DOCLING_DO_PICTURE_CLASSIFICATION=true

# Chunking (ADR-013). These are the defaults every ingestion run inherits.
# The ceiling is a prior, not a decision: IR-116 settles it by reading real
# chunks (manage.py inspect_chunks). AI_CHUNK_MIN_TOKENS blank means "derive
# it from the ceiling".
# Blank uses the domain's registered default strategy. Set one only to pin a
# different registered id -- an unknown id raises rather than falling back.
# Django's cache (IR-132). Same Redis as Celery, different database number,
# so flushing a queue cannot take the query-embedding cache with it.
REDIS_CACHE_URL=redis://localhost:6379/1
CACHE_TIMEOUT_SECONDS=86400
# The vendor account's per-minute token budget, split between the ingestion and
# query lanes. The query lane gets the larger share -- a person is waiting on it.
AI_RATE_LIMIT_TOKENS_PER_MINUTE=1000000

# Inference provider (ADR-036). Groq for development, OpenRouter for
# production -- both speak the OpenAI chat format, so switching is these three
# values and no new code. Anthropic is not used.
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# A model id is a vendor's catalogue entry and they are withdrawn without
# notice -- llama-3.3-70b-versatile was the default here until Groq dropped
# it, and every call 404'd while the app still reported generative mode.
# Groq ids need the vendor prefix: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.8-27b. `GET {LLM_BASE_URL}/models` lists what a key can reach.
# Left empty: `openai/gpt-oss-120b` is the shipped default when this is unset,
# and *setting* a model here with no LLM_API_KEY is a configured-but-keyless
# `answer` task, which stops Django starting (IR-379). Set both, or neither.
LLM_MODEL=
LLM_TEMPERATURE=0.1
# Unset by default. A Groq/openai/gpt-oss-120b extension ("low"/"medium"/
# "high") for streamed answers (IR-325) -- also requests include_reasoning,
# so reasoning tokens stream on their own channel instead of the answer text.
# A vendor that doesn't recognise it ignores it.
LLM_REASONING_EFFORT=

# There is no second-vendor key here any more (IR-385). LLM_FALLBACK_BASE_URL,
# LLM_FALLBACK_API_KEY and LLM_FALLBACK_MODEL configured a second vendor, which
# ADR-008 rejects; they are deleted and setting one now refuses startup. Use
# LLM_<TASK>_FALLBACK_MODELS below -- an ordered list of models on the account
# that task already reaches.

# Inference tasks and Profiles (IR-378, ADR-036 Amendment) -- one Profile per
# named task: answer, resolve, summary, describe_figure. VENDOR is "groq",
# "openrouter", or empty for Groq. Empty means inherit: `answer` falls back to
# the flat LLM_* keys above, so an existing deployment needs none of these.
# The other tasks are off until given a model. FALLBACK_MODELS is a
# comma-separated list of models at the SAME vendor account (ADR-008
# Amendment) -- a second vendor is not a fallback. REASONING is on for answer
# alone; it is the only task a reader watches work.
#
# A task named at "openrouter" gets OpenRouter's own dialect (IR-384), not
# just Groq's shape at a different URL: reasoning travels as OpenRouter's
# `reasoning` object rather than Groq's `reasoning_effort`/`include_reasoning`
# pair, and is explicitly excluded (not merely omitted) when REASONING is
# False, since a model behind OpenRouter may reason unprompted. Every request
# declares OpenRouter's no-training data policy, task or not. FALLBACK_MODELS
# is walked as a separate request per model, stopping at the first that
# answers, for a vendor with no native multi-model field -- Groq. OpenRouter's
# dialect resolves the list itself instead, as its native `models` field, in
# one request (IR-385).
#
# Two mistakes here stop Django starting, rather than surfacing days later as
# a failed answer (IR-379). A task name that is not one of the four -- a
# typo like LLM_ANWSER_MODEL configures nothing, and without the refusal it
# reads as a feature that was never switched on. And a task whose MODEL is set
# while its API_KEY is not: that is a deployment mistake, not an off switch.
# Leaving a task's MODEL empty is the off switch, and it is how a developer
# with only a Groq key runs IRIS with no OpenRouter account. `manage.py check`
# reports both without booting a server.
LLM_ANSWER_VENDOR=
LLM_ANSWER_BASE_URL=
LLM_ANSWER_API_KEY=
LLM_ANSWER_MODEL=
LLM_ANSWER_FALLBACK_MODELS=
LLM_ANSWER_REASONING=True
# Question resolution runs here as of IR-383 -- the model that rewrites a
# follow-up like "what about its limitations?" into a standalone question
# before retrieval. Unlike the other tasks it is NOT off when unset: it has
# shipped since IR-296, so leaving these empty keeps the shipped default
# model over the flat LLM_BASE_URL/LLM_API_KEY account. Naming a VENDOR stops
# it inheriting that BASE_URL and API_KEY together, so a task cannot end up
# at one vendor authenticated for another; leave VENDOR empty to inherit
# both. The old LLM_RESOLUTION_MODEL namespace is gone -- setting it now
# stops Django starting, with the rename in the message.
LLM_RESOLVE_VENDOR=
LLM_RESOLVE_BASE_URL=
LLM_RESOLVE_API_KEY=
LLM_RESOLVE_MODEL=
LLM_RESOLVE_FALLBACK_MODELS=
LLM_RESOLVE_REASONING=False
# The AI Summary on a Record's page runs here as of IR-380, and inherits
# nothing: with no LLM_SUMMARY_MODEL the summary reports "unavailable" and no
# vendor is called, however the answer task is configured. Pick something
# cheap -- it is not interactive, and REASONING stays False.
LLM_SUMMARY_VENDOR=
LLM_SUMMARY_BASE_URL=
LLM_SUMMARY_API_KEY=
LLM_SUMMARY_MODEL=
LLM_SUMMARY_FALLBACK_MODELS=
LLM_SUMMARY_REASONING=False
# Reserved, and read by profile_for like any other task -- nothing calls the
# describe_figure task, and its own spec has to supersede ADR-025 first.
LLM_DESCRIBE_FIGURE_VENDOR=
LLM_DESCRIBE_FIGURE_BASE_URL=
LLM_DESCRIBE_FIGURE_API_KEY=
LLM_DESCRIBE_FIGURE_MODEL=
LLM_DESCRIBE_FIGURE_FALLBACK_MODELS=
LLM_DESCRIBE_FIGURE_REASONING=False

# Question resolution (ADR-026) -- the on/off switch only; the model is
# LLM_RESOLVE_MODEL above (IR-383). False switches the whole feature off,
# independent of everything else here, and a follow-up is then searched with
# the question as the reader typed it.
AI_QUESTION_RESOLUTION_ENABLED=True

# Conversation memory (ADR-026, IR-297) -- older Turns found by search, not
# summarised. No vendor key. AI_CONVERSATION_MEMORY_ENABLED=False switches it
# off independently of everything else here.
AI_CONVERSATION_MEMORY_ENABLED=True

# The relevance floor for that recall (IR-446) -- a cosine distance, read per
# request. Turns at or beyond it are dropped rather than offered to the model
# as relevant; 0 or less disables the cut-off. PROVISIONAL: 0.80 comes from
# observed voyage-context-4 distances (see config/settings/base.py), where
# related Turns measured 0.26-0.74 and unrelated ones 0.83 and up.
AI_MEMORY_RECALL_MAX_DISTANCE=0.80

# A Turn's answer vector (ADR-026 §7 as amended, IR-447) -- each Turn is
# stored with two vectors: its question, which retrieval already computed and
# costs nothing, and its answer, which is one extra Voyage call per answered
# question. The second is what lets memory find a Turn by what it *said*: a
# Turn whose answer names a figure its question never mentioned is otherwise
# unreachable. False restores question-only recall and makes no extra call.
# Turns that failed or found nothing are never embedded -- their text is an
# explanation, not an answer.
AI_MEMORY_ANSWER_VECTOR_ENABLED=True

# The verbatim history window (IR-449) -- a TOKEN BUDGET, not a Turn count.
# History fills newest-first until the budget is reached and then stops, so a
# conversation of short exchanges carries further back than one of long
# answers. The newest Turn is always included, truncated if it alone exceeds
# the budget. 3000 holds roughly what the old fixed six Turns held for a
# conversation of ordinary length; the resolver prompt and the answering
# prompt share this one window. No vendor call is made to count anything.
AI_HISTORY_TOKEN_BUDGET=3000

# Safety margin on that count. Counting uses the pinned voyage-context-4
# tokenizer already in the repository, while the answering model is a Llama-
# or Qwen-class model, so the number is a conservative estimate rather than a
# measurement -- every count is multiplied by this and rounded up. 1.15
# covers the spread between modern 100k-150k-vocabulary BPEs on English
# prose. Values below 1.0 are clamped to 1.0. IR-330 would supply the real
# usage figures to calibrate it against.
AI_HISTORY_TOKEN_MARGIN=1.15

# Hybrid retrieval (ADR-033 §1-2, IR-395) -- keyword search runs alongside
# vector search over the whole visible catalogue, and the two ranked lists are
# merged by rank position before reranking. It is what makes an exact term
# ("YOLOv8", a surname, an instrument name) findable when the embedding blurs
# it. Two settings for two decisions, but one technique: neither does anything
# alone, so move both together.
#
# BOTH DEFAULT OFF and stay off here. With them off, retrieval is vector-only
# on the healthy path and full-text search keeps only its ADR-008 outage job,
# which is exactly today's behaviour. ADR-033 §5 changes a default only on a
# run of the ADR-023 harness, and that run is IR-402's.
AI_KEYWORD_RETRIEVAL_ENABLED=False
AI_RETRIEVAL_FUSION_ENABLED=False

# How many rows pgvector's HNSW index scans per filtered vector query (IR-440).
# Its own default is 40, which capped the reranker's candidates at 40. 1..1000.
AI_HNSW_EF_SEARCH=200

# Voyage (ADR-015) -- embedding and reranking, one vendor for both stages.
# No default key and no local fallback: the adapter raises when it is absent
# rather than degrading silently. voyage-context-4 is 1024 dimensions, which
# must match the active EmbeddingSpace row or indexing and querying disagree.
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-context-4
VOYAGE_RERANK_MODEL=rerank-3
VOYAGE_TIMEOUT_SECONDS=60

# The development disclosure bypass (IR-317, ADR-015 §A development bypass).
# ADR-015's gate refuses every record until IR-250 gives `Record` an embargo
# field, so with this off nothing indexes and Ask IRIS answers "no readable
# sources" to every question. Set it to 1 on a development machine to click
# the feature through a browser. It is NOT a policy: it encodes no rule about
# what may be disclosed, it only stands beside the gate.
# Django REFUSES TO START with this set while DEBUG is off, and every use logs
# a warning. Point it only at content already cleared to leave. IR-250 deletes
# this setting.
AI_DISCLOSURE_BYPASS_FOR_DEVELOPMENT=0

# ---- The evidence decision (IR-464, ADR-035) ----------------------------
# Whether Ask IRIS establishes, before retrieval, that a question needs corpus
# evidence at all. off | shadow ONLY -- `on` is REJECTED as an invalid value,
# not merely unimplemented, and Django refuses to start on it. `shadow` records
# a decision per sampled chat Turn on the `shadow` Celery queue and changes no
# answer (IR-466); production routing is out of ADR-035's scope. DO NOT set
# `shadow` where real reader questions flow until the vendor's request- and
# response-data retention is verified (ADR-035 §11).
AI_EVIDENCE_DECISION=off
# Fraction of chat Turns shadowed, 0.0-1.0. Zero records nothing.
AI_EVIDENCE_SHADOW_SAMPLE_RATE=0.0
# Shadow's own token budget per minute; past it a decision is skipped and
# counted as missing coverage. Never a share of the reader's budget.
AI_EVIDENCE_SHADOW_TOKENS_PER_MINUTE=20000
# Seconds before a running decision may be reclaimed by another worker, once.
AI_EVIDENCE_SHADOW_STALE_SECONDS=600
# The institution and Area terms the `institution_term` rule raises on, comma
# separated. Deployment-specific (ADR-005, instance per tenant); the other four
# rules' English terms are in code. READ AT STARTUP, not per request, so a
# change here needs a restart. Django refuses to start when this is empty and
# AI_EVIDENCE_DECISION is not off -- disable the rule by turning the feature
# off, never by blanking this string.
AI_EVIDENCE_INSTITUTION_TERMS=CIT-U,CIT University,Cebu Institute of Technology,IRIS,this repository,the repository
# Academic Areas this deployment publishes under. Empty is fine.
AI_EVIDENCE_AREA_TERMS=

# Embedding spend (IR-282). Indexing is metered per token, and the chunk
# ceiling below counts WORDS, so a misconfigured chunk size is a live way to
# spend real money on a mistake. `backfill_embeddings` prints its estimate and
# REFUSES to start above this; 0 disables the guard. Raising it is a
# deliberate act by whoever is paying.
AI_EMBEDDING_TOKEN_CEILING=2000000
# Approximate, and printed as approximate -- a figure for deciding whether a
# run is worth starting, never a quote. Check vendor pricing before trusting
# a large number.
AI_EMBEDDING_COST_PER_MILLION_TOKENS=0.12

AI_CHUNK_STRATEGY=
# REAL voyage-context-4 TOKENS since IR-287. This counted whitespace WORDS
# until then, and 512 of those measured ~700 real BPE tokens on a real
# submission (IR-243) -- so the ceiling moved to 700 in the same change that
# made the counter honest, and chunk boundaries on prose did not move. What
# the right ceiling is for theses is still open for IR-133's recall@10
# harness; changing it re-chunks and re-embeds every record.
AI_CHUNK_MAX_TOKENS=700
AI_CHUNK_MIN_TOKENS=
# 64 real tokens, the equivalent of the 48 words this was before IR-287.
AI_CHUNK_CONTEXT_PATH_MAX_TOKENS=64
# Navigation indexes are excluded alongside the bibliography (IR-246): a
# table of contents carries every section name and none of their content.
# The title block is deliberately still chunked.
AI_CHUNK_EXCLUDE_SECTIONS=References,Bibliography,Works Cited,Literature Cited,Table of Contents,Contents,List of Tables,List of Figures

# Resubmission policy (ADR-004). 'clearance_aware' preserves every
# non-declining office's completed review -- the contribution, and the only
# correct value for a production instance. 'restart_all' resets them all and
# exists solely as the evaluation comparison arm.
#
# DO NOT set this to restart_all on an instance with real reviewers: it discards
# clearances they have already granted. The comparison runs on a dedicated,
# short-lived evaluation instance. An unrecognised value stops the app at
# startup rather than falling back, so a typo fails loudly instead of quietly
# running the wrong arm. Case does not matter: RESTART_ALL also works.
RESUBMISSION_POLICY=clearance_aware

# Frontend
FRONTEND_URL=http://localhost:5173

# Comma-separated CORS allowlist. Optional in development (it defaults to
# FRONTEND_URL); REQUIRED in production, where every entry must be https
# and there is no 'allow all' switch in any settings module.
# CORS_ALLOWED_ORIGINS=https://iris.cit.edu

# Django axes (brute force)
AXES_FAILURE_LIMIT=3

# IR-489: comma-separated OpenRouter provider slugs, per task.
# Choose verified US/EU endpoints; a bare provider slug may match all regions.
# OpenRouter answers require a pin; other tasks can leave it empty.
# A pin on Groq refuses startup. ZDR is not required by IR-485.
LLM_ANSWER_PROVIDER_ONLY=
LLM_RESOLVE_PROVIDER_ONLY=
LLM_SUMMARY_PROVIDER_ONLY=
LLM_DESCRIBE_FIGURE_PROVIDER_ONLY=
