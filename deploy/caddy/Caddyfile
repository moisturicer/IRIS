# TLS for production (IR-847, ADR-057). Caddy gets and renews the certificate for
# IRIS_DOMAIN and redirects plain HTTP to HTTPS, because the site address has no
# scheme. nginx isn't published, so this is the only way in from outside.
#
# IRIS_CADDY_OPTIONS adds global options. It is empty in production, and the CI
# check sets `local_certs` because a test has no public domain.
{
	{$IRIS_CADDY_OPTIONS}
	servers {
		# HTTP/3 needs UDP 443, which Compose doesn't publish, so don't advertise it.
		protocols h1 h2
	}
}

{$IRIS_DOMAIN} {
	tls {
		protocols tls1.2 tls1.3
	}

	# HSTS on every HTTPS response (IR-806, ASVS 14.4.5). Django sent it only on
	# its own responses, so the pages and files nginx serves went without. The
	# value is production.py's (ADR-057). `defer` sets it after the upstream
	# answers, so a Django response carries one header, not two.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		defer
	}

	# With no trusted_proxies set, Caddy discards the client's X-Forwarded-For and
	# X-Forwarded-Proto and sends its own. TRUSTED_PROXY_COUNT=2 relies on that.
	reverse_proxy frontend:8080
}
