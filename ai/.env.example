# IRIS AI Gateway — example environment (IR-156)
#
# Copy to ai/.env before running the stack:
#     cp ai/.env.example ai/.env
#
# ai/.env is gitignored. Its absence is what made `docker compose config` fail
# with "env file .../ai/.env not found", which is why the Compose CI job has
# been red since 2026-09-02.
#
# HOLDS NO REAL VALUES. Every secret below is a placeholder.

# --- Service-to-service authentication (ADR-014 precondition 1) --------------
# Shared with Django, which sends it as the `x-iris-service-secret` header on
# every gateway call. The gateway refuses all traffic with 503 when this is
# empty, so an unconfigured deployment fails loudly rather than serving a
# vendor API key to anyone who can reach the port.
#
# Generate a real one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_SECRET=replace-me-with-a-generated-secret

# --- Provider ----------------------------------------------------------------
# The gateway has one LLM adapter today (ADR-008/015: no local model, no second
# provider). An unrecognised name raises rather than falling through to a mock.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- App ---------------------------------------------------------------------
APP_NAME=IRIS AI Gateway
DEBUG=False

# NOTE: there is deliberately no CORS setting. A browser is not a client of
# this service — Django is. See ai/main.py.

# --- AI-owned runs (IR-722) ---------------------------------------------------
# A login in the iris_ai_runtime role. Blank keeps the run routes unavailable.
# The maintenance login never goes in this file: running services load it and
# refuse runs with that login set (ADR-014, IR-826). Give it to the one command:
#   RUNS_MIGRATION_DATABASE_URL=... python -m ai.runs.migrate
RUNS_DATABASE_URL=
# What new runs are pinned to. "agent" pins them to the AGENT research
# Conversation and needs the whole AGENT profile below; any part missing or
# invalid refuses to start (IR-862). Each run keeps the executor it was pinned
# to: an agent worker still answers deterministic runs, and a worker leaves a
# run pinned to anything it does not serve queued for one that does.
# "agent" since IR-957: the runtime answers every reader question.
# "deterministic" is for tests and offline development only.
RUNS_EXECUTOR=agent
# Safety ceilings per run, not the budget. Spending is capped on the OpenRouter
# key (its credit limit); change these freely.
RUNS_DEADLINE_SECONDS=120
RUNS_LEASE_SECONDS=210
RUNS_MAX_ATTEMPTS=14
RUNS_MAX_INPUT_TOKENS=700000
RUNS_MAX_OUTPUT_TOKENS=100000
RUNS_MAX_COST_USD=5

# --- Run dispatch (IR-723) ----------------------------------------------------
# A deep run's own deadline; the active-run population overall and per reader
# (beyond it: 503 busy); runs at once per reader; deep runs at once (below
# RUNS_WORKER_CONCURRENCY, so ordinary questions keep the other slots); slots
# per `python -m ai.runs.worker`.
RUNS_DEEP_DEADLINE_SECONDS=600
RUNS_MAX_QUEUED=50
RUNS_MAX_ACTIVE_PER_READER=3
RUNS_MAX_RUNNING_PER_READER=1
RUNS_DEEP_CONCURRENCY=2
RUNS_WORKER_CONCURRENCY=4
RUNS_POLL_SECONDS=2
# Wakeups only, never proof of work; blank makes workers poll PostgreSQL.
RUNS_REDIS_URL=

# IR-889 public-proxy paid-send manifest (JSON). Leave empty outside the
# approved development pilot. Each source names record_id, chunk_set_id and
# extraction_hash. Also name approval_id=IR-889, the exact model, endpoint,
# account digest, campaign, and an ISO-8601 expires_at. A real OpenRouter send
# also requires vendor_evidence (an IR-827 evidence URL) and routing_digest
# (SHA-256 of the canonical JSON routing object). Real institutional Records
# remain refused regardless of this setting.
RUNS_PROXY_SEND_APPROVAL=
# The manifest is considered only in the explicitly named development stage.
RUNS_DEPLOYMENT_STAGE=production
# Agent search by meaning (IR-886): query embeddings need the AGENT profile and this key.
VOYAGE_API_KEY=
# Names a Voyage rerank model to turn reranking on; empty keeps it off.
RUNS_RERANK_MODEL=

# --- Provider admission (IR-725) ----------------------------------------------
# Django and the runtime record every paid attempt in one ledger. The dollar
# limit that matters is set on the OpenRouter key; these campaign ceilings are
# set high so they do not get in the way. Both runtimes need the same values.
AI_ADMISSION_CAMPAIGN=iris
AI_ADMISSION_CAMPAIGN_MAX_ATTEMPTS=1000000
AI_ADMISSION_CAMPAIGN_MAX_INPUT_TOKENS=10000000000
AI_ADMISSION_CAMPAIGN_MAX_OUTPUT_TOKENS=1000000000
AI_ADMISSION_CAMPAIGN_MAX_COST_USD=100000
AI_ADMISSION_CAMPAIGN_MAX_ACTIVE_MINUTES=1000000
AI_ADMISSION_RESERVE_FRACTION=0.01
AI_ADMISSION_RESERVE_RELEASED=True
# JSON; AI runs use the "research" lane.
AI_ADMISSION_LANE_CONCURRENCY={"research":8,"chat":4,"ingestion":2,"overview":2,"shadow":1,"embedding":4,"reranking":4,"extraction":2}
AI_ADMISSION_ACCOUNT_CONCURRENCY=12
AI_ADMISSION_MAX_OUTPUT_TOKENS=8000
# AI_ADMISSION_LEASE_GRACE_SECONDS=

# --- AGENT model (IR-860, IR-862) ----------------------------------------------
# The model that answers Ask IRIS and Paper Chat. To change or add one, edit the
# four lines marked [model] and keep the names identical:
#   1. AGENT_LLM_MODELS      the models this endpoint may serve (comma-separated)
#   2. AGENT_LLM_CAPACITIES  one entry per model: its context and output limits
#   3. AI_ADMISSION_PRICES   one entry per model: US$ per million tokens
#   4. RUNS_AGENT_MODEL      which one new runs use
# Prices and limits are on the model's page at openrouter.ai.
AGENT_LLM_ENDPOINT=https://openrouter.ai/api/v1
# Your OpenRouter key. Set its credit limit in the OpenRouter dashboard.
AGENT_LLM_API_KEY=sk-or-replace-me
AGENT_LLM_CAPABILITIES=tools,parallel_tools,continuation
AGENT_LLM_DATA_POLICY=no-training
# OpenRouter provider controls. "only" names the provider(s) to use and
# max_price (US$ per million tokens) must not be below the model's price.
AGENT_LLM_ROUTING={"only":["azure"],"allow_fallbacks":false,"data_collection":"deny","zdr":true,"require_parameters":true,"max_price":{"prompt":0.1,"completion":0.5}}
# [model]
AGENT_LLM_MODELS=openai/gpt-6-luna:floor
# [model]
AGENT_LLM_CAPACITIES={"openai/gpt-6-luna:floor":{"context_tokens":272000,"max_output_tokens":8000,"max_reasoning_tokens":null,"max_request_bytes":1000000,"min_bytes_per_token":1.0,"framing_tokens_per_message":8}}
# [model]
AI_ADMISSION_PRICES={"openai/gpt-6-luna:floor":{"input":0.1,"output":0.5},"voyage-context-4":{"input":0.12,"output":0},"rerank-3":{"input":0.05,"output":0}}
# [model]
RUNS_AGENT_MODEL=openai/gpt-6-luna:floor

RUNS_AGENT_BOUNDS={"ordinary":{"max_steps":4,"max_tool_calls":4,"max_no_progress":2,"final_seconds":30,"history_turns":6},"deep":{"max_steps":10,"max_tool_calls":10,"max_no_progress":3,"final_seconds":60,"history_turns":6}}
RUNS_AGENT_RESERVES={"output_tokens":4000,"reasoning_tokens":4000,"next_result_tokens":9000,"repair_tokens":1500}
# Optional (IR-734); blank never compacts. JSON exactly
#   {threshold_tokens, summary_tokens, keep_exchanges, max_attempts}
# RUNS_AGENT_COMPACTION=

# IR-737: optional ingestion-only Redis hints; blank uses durable DB polling.
# Configure the same URL for Django publication and the separate ingestion worker.
INGESTION_REDIS_URL=
