# IRIS AI Gateway — example environment (IR-156)
#
# Copy to ai/.env before running the stack:
#     cp ai/.env.example ai/.env
#
# ai/.env is gitignored. Its absence is what made `docker compose config` fail
# with "env file .../ai/.env not found", which is why the Compose CI job has
# been red since 2026-09-02.
#
# HOLDS NO REAL VALUES. Every secret below is a placeholder.

# --- Service-to-service authentication (ADR-014 precondition 1) --------------
# Shared with Django, which sends it as the `x-iris-service-secret` header on
# every gateway call. The gateway refuses all traffic with 503 when this is
# empty, so an unconfigured deployment fails loudly rather than serving a
# vendor API key to anyone who can reach the port.
#
# Generate a real one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_SECRET=replace-me-with-a-generated-secret

# --- Provider ----------------------------------------------------------------
# The gateway has one LLM adapter today (ADR-008/015: no local model, no second
# provider). An unrecognised name raises rather than falling through to a mock.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- App ---------------------------------------------------------------------
APP_NAME=IRIS AI Gateway
DEBUG=False

# NOTE: there is deliberately no CORS setting. A browser is not a client of
# this service — Django is. See ai/main.py.

# --- AI-owned runs (IR-722) ---------------------------------------------------
# A login in the iris_ai_runtime role, and a maintenance login for
# `python -m ai.runs.migrate`. Blank keeps the run routes unavailable.
RUNS_DATABASE_URL=
RUNS_MIGRATION_DATABASE_URL=
RUNS_EXECUTOR=deterministic
# No defaults and none approved: while any is unset, every submission is
# refused rather than admitted with a guessed allowance.
# RUNS_DEADLINE_SECONDS=
# RUNS_LEASE_SECONDS=
# RUNS_MAX_ATTEMPTS=
# RUNS_MAX_INPUT_TOKENS=
# RUNS_MAX_OUTPUT_TOKENS=
# RUNS_MAX_COST_USD=

# --- Run dispatch (IR-723) ----------------------------------------------------
# Also required and unapproved. A deep run's own deadline; the active-run
# population overall and per reader (beyond it: 503 busy); runs at once per
# reader; deep runs at once (below RUNS_WORKER_CONCURRENCY, so ordinary
# questions keep the other slots); slots per `python -m ai.runs.worker`.
# RUNS_DEEP_DEADLINE_SECONDS=
# RUNS_MAX_QUEUED=
# RUNS_MAX_ACTIVE_PER_READER=
# RUNS_MAX_RUNNING_PER_READER=
# RUNS_DEEP_CONCURRENCY=
# RUNS_WORKER_CONCURRENCY=
# RUNS_POLL_SECONDS=
# Wakeups only, never proof of work; blank makes workers poll PostgreSQL.
RUNS_REDIS_URL=

# --- Provider admission (IR-725) ----------------------------------------------
# The same names and values as Django's (backend/.env.example, IR-545): both
# runtimes spend one campaign in one ledger. A run's own ceiling is its
# AskRun allowance (RUNS_MAX_*). Unset refuses every paid attempt.
# AI_ADMISSION_CAMPAIGN=
# AI_ADMISSION_CAMPAIGN_MAX_ATTEMPTS=
# AI_ADMISSION_CAMPAIGN_MAX_INPUT_TOKENS=
# AI_ADMISSION_CAMPAIGN_MAX_OUTPUT_TOKENS=
# AI_ADMISSION_CAMPAIGN_MAX_COST_USD=
# AI_ADMISSION_CAMPAIGN_MAX_ACTIVE_MINUTES=
# AI_ADMISSION_RESERVE_FRACTION=
# AI_ADMISSION_RESERVE_RELEASED=
# AI_ADMISSION_LANE_CONCURRENCY=   # JSON; AI runs use the "research" lane
# AI_ADMISSION_ACCOUNT_CONCURRENCY=
# AI_ADMISSION_PRICES=
# AI_ADMISSION_MAX_OUTPUT_TOKENS=
# AI_ADMISSION_LEASE_GRACE_SECONDS=
