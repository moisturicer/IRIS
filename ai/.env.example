# IRIS AI Gateway — example environment (IR-156)
#
# Copy to ai/.env before running the stack:
#     cp ai/.env.example ai/.env
#
# ai/.env is gitignored. Its absence is what made `docker compose config` fail
# with "env file .../ai/.env not found", which is why the Compose CI job has
# been red since 2026-09-02.
#
# HOLDS NO REAL VALUES. Every secret below is a placeholder.

# --- Service-to-service authentication (ADR-014 precondition 1) --------------
# Shared with Django, which sends it as the `x-iris-service-secret` header on
# every gateway call. The gateway refuses all traffic with 503 when this is
# empty, so an unconfigured deployment fails loudly rather than serving a
# vendor API key to anyone who can reach the port.
#
# Generate a real one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_SECRET=replace-me-with-a-generated-secret

# --- Provider ----------------------------------------------------------------
# The gateway has one LLM adapter today (ADR-008/015: no local model, no second
# provider). An unrecognised name raises rather than falling through to a mock.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- App ---------------------------------------------------------------------
APP_NAME=IRIS AI Gateway
DEBUG=False

# NOTE: there is deliberately no CORS setting. A browser is not a client of
# this service — Django is. See ai/main.py.

# --- AI-owned runs (IR-722) ---------------------------------------------------
# A login in the iris_ai_runtime role. Blank keeps the run routes unavailable.
# The maintenance login never goes in this file: running services load it and
# refuse runs with that login set (ADR-014, IR-826). Give it to the one command:
#   RUNS_MIGRATION_DATABASE_URL=... python -m ai.runs.migrate
RUNS_DATABASE_URL=
# What new runs are pinned to. "agent" pins them to the AGENT research
# Conversation and needs the whole AGENT profile below; any part missing or
# invalid refuses to start (IR-862). Each run keeps the executor it was pinned
# to: an agent worker still answers deterministic runs, and a worker leaves a
# run pinned to anything it does not serve queued for one that does.
RUNS_EXECUTOR=deterministic
# No defaults and none approved: while any is unset, every submission is
# refused rather than admitted with a guessed allowance.
# RUNS_DEADLINE_SECONDS=
# RUNS_LEASE_SECONDS=
# RUNS_MAX_ATTEMPTS=
# RUNS_MAX_INPUT_TOKENS=
# RUNS_MAX_OUTPUT_TOKENS=
# RUNS_MAX_COST_USD=

# --- Run dispatch (IR-723) ----------------------------------------------------
# Also required and unapproved. A deep run's own deadline; the active-run
# population overall and per reader (beyond it: 503 busy); runs at once per
# reader; deep runs at once (below RUNS_WORKER_CONCURRENCY, so ordinary
# questions keep the other slots; deep is the default depth, so this caps most
# runs); slots per `python -m ai.runs.worker`.
# RUNS_DEEP_DEADLINE_SECONDS=
# RUNS_MAX_QUEUED=
# RUNS_MAX_ACTIVE_PER_READER=
# RUNS_MAX_RUNNING_PER_READER=
# RUNS_DEEP_CONCURRENCY=
# RUNS_WORKER_CONCURRENCY=
# RUNS_POLL_SECONDS=
# Wakeups only, never proof of work; blank makes workers poll PostgreSQL.
RUNS_REDIS_URL=

# --- Provider admission (IR-725) ----------------------------------------------
# The same names and values as Django's (backend/.env.example, IR-545): both
# runtimes spend one campaign in one ledger. A run's own ceiling is its
# AskRun allowance (RUNS_MAX_*). Unset refuses every paid attempt.
# AI_ADMISSION_CAMPAIGN=
# AI_ADMISSION_CAMPAIGN_MAX_ATTEMPTS=
# AI_ADMISSION_CAMPAIGN_MAX_INPUT_TOKENS=
# AI_ADMISSION_CAMPAIGN_MAX_OUTPUT_TOKENS=
# AI_ADMISSION_CAMPAIGN_MAX_COST_USD=
# AI_ADMISSION_CAMPAIGN_MAX_ACTIVE_MINUTES=
# AI_ADMISSION_RESERVE_FRACTION=
# AI_ADMISSION_RESERVE_RELEASED=
# AI_ADMISSION_LANE_CONCURRENCY=   # JSON; AI runs use the "research" lane
# AI_ADMISSION_ACCOUNT_CONCURRENCY=
# AI_ADMISSION_PRICES=
# AI_ADMISSION_MAX_OUTPUT_TOKENS=
# AI_ADMISSION_LEASE_GRACE_SECONDS=

# --- AGENT provider (IR-860) ---------------------------------------------------
# The chat-completions endpoint AGENT runs may be pinned to. Every name is
# required and none is approved; nothing calls it until a worker is wired to
# it (IR-862), and then only through provider admission above.
# AGENT_LLM_ENDPOINT=            # base URL; requests go to <endpoint>/chat/completions
# AGENT_LLM_API_KEY=
# AGENT_LLM_MODELS=              # comma-separated model names this endpoint serves
# AGENT_LLM_CAPABILITIES=        # e.g. tools,parallel_tools,continuation
# AGENT_LLM_DATA_POLICY=         # "no-training" only once the vendor terms say so
# AGENT_LLM_CAPACITIES=          # JSON {model: {context_tokens, max_output_tokens,
#                                #   max_reasoning_tokens, max_request_bytes,
#                                #   min_bytes_per_token, framing_tokens_per_message}};
#                                #   a listed model left out stays capacity_unknown

# --- AGENT profile (IR-862) ----------------------------------------------------
# Required only with RUNS_EXECUTOR=agent, with every AGENT_LLM_* and
# AI_ADMISSION_* name above; none is approved. The model must be listed, have
# a declared capacity and a price in AI_ADMISSION_PRICES; the data policy must
# be "no-training". A run keeps the Bounds of its depth from submission.
# The gateway's API process reads the same profile, since it pins submissions.
# RUNS_AGENT_MODEL=
# RUNS_AGENT_BOUNDS=             # JSON {"ordinary": {...}, "deep": {...}}, each exactly
#                                #   max_steps, max_tool_calls, max_no_progress,
#                                #   final_seconds, history_turns
# RUNS_AGENT_RESERVES=           # JSON {output_tokens, reasoning_tokens,
#                                #   next_result_tokens, repair_tokens}

# IR-737: optional ingestion-only Redis hints; blank uses durable DB polling.
# Configure the same URL for Django publication and the separate ingestion worker.
INGESTION_REDIS_URL=
