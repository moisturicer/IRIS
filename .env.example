# Repo-root environment for Docker Compose (IR-154).
#
# Copy to `.env` at the repository root before `docker compose up`. Compose
# substitutes these into docker-compose.yml and docker-compose.prod.yml; every
# one of them is written `${VAR:?...}`, so an unset value stops the stack with
# a named error rather than falling back to a credential committed here.
#
# This is the *only* place the database credential is configured for the
# Compose stack: the same three values provision the Postgres container and
# reach Django and every Celery worker, so the two can no longer disagree.
# Running Django outside Compose reads backend/.env instead — see
# backend/.env.example.
#
# `.env` is gitignored. This file documents the keys and holds no real values.

# Database. Pick a strong password per deployment:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_NAME=
DB_USER=
DB_PASSWORD=
