' Shared style for every Section D diagram (IR-1021).
' Include it first: !include ../iris-style.puml  (paths are relative to src/)
' One palette, one font and one line style, so every diagram reads the same.
' Sized for the printed report (IR-1022): every PNG is at most 1,400 px wide at
' 140 dpi, so 11-pt text still prints at 7 pt or larger across a 6.5-inch page.

!$ink = "#1F2937"
!$line = "#475569"
!$muted = "#64748B"
!$paper = "#FFFFFF"
!$panel = "#F8FAFC"
!$core = "#E0F2FE"
!$coreBorder = "#0369A1"
!$ext = "#FEF3C7"
!$extBorder = "#B45309"
!$retired = "#F1F5F9"
!$retiredBorder = "#94A3B8"
!$accent = "#DCFCE7"
!$accentBorder = "#15803D"

skinparam dpi 140
skinparam backgroundColor $paper
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam defaultFontColor $ink
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor $line
skinparam ArrowThickness 1.0
skinparam ArrowFontSize 9
skinparam ArrowFontColor $muted
skinparam LineType ortho
skinparam Padding 2
skinparam wrapWidth 260
skinparam maxMessageSize 180
skinparam nodesep 22
skinparam ranksep 34

skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam CaptionFontSize 9
skinparam CaptionFontColor $muted
skinparam LegendBackgroundColor $panel
skinparam LegendBorderColor $retiredBorder
skinparam LegendFontSize 9

skinparam package {
  BackgroundColor $panel
  BorderColor $retiredBorder
  FontStyle bold
  FontColor $ink
}
skinparam rectangle {
  BackgroundColor $core
  BorderColor $coreBorder
}
skinparam component {
  BackgroundColor $core
  BorderColor $coreBorder
}
skinparam node {
  BackgroundColor $panel
  BorderColor $line
}
skinparam database {
  BackgroundColor $core
  BorderColor $coreBorder
}
skinparam queue {
  BackgroundColor $core
  BorderColor $coreBorder
}
skinparam cloud {
  BackgroundColor $ext
  BorderColor $extBorder
}
skinparam actor {
  BackgroundColor $paper
  BorderColor $ink
}
skinparam usecase {
  BackgroundColor $core
  BorderColor $coreBorder
}
skinparam class {
  BackgroundColor $paper
  BorderColor $coreBorder
  HeaderBackgroundColor $core
  AttributeFontSize 10
  StereotypeFontSize 9
}
skinparam entity {
  BackgroundColor $paper
  BorderColor $coreBorder
}
skinparam note {
  BackgroundColor $panel
  BorderColor $retiredBorder
  FontSize 10
}

' Stereotype colours used across every diagram
skinparam rectangle<<external>> {
  BackgroundColor $ext
  BorderColor $extBorder
}
skinparam component<<external>> {
  BackgroundColor $ext
  BorderColor $extBorder
}
skinparam actor<<external>> {
  BackgroundColor $ext
  BorderColor $extBorder
}
skinparam usecase<<ai>> {
  BackgroundColor $accent
  BorderColor $accentBorder
}
skinparam component<<ai>> {
  BackgroundColor $accent
  BorderColor $accentBorder
}
skinparam rectangle<<ai>> {
  BackgroundColor $accent
  BorderColor $accentBorder
}
skinparam class<<ref>> {
  BackgroundColor $panel
  HeaderBackgroundColor $panel
  BorderColor $retiredBorder
}
skinparam class<<retained>> {
  BackgroundColor $retired
  HeaderBackgroundColor $retired
  BorderColor $retiredBorder
  FontColor $muted
}
skinparam class<<ai>> {
  HeaderBackgroundColor $accent
  BorderColor $accentBorder
}
hide circle
skinparam participant {
  BackgroundColor $core
  BorderColor $coreBorder
}
skinparam sequence {
  LifeLineBorderColor $muted
  GroupBorderColor $retiredBorder
  GroupBackgroundColor $panel
}
skinparam activity {
  BackgroundColor $core
  BorderColor $coreBorder
  DiamondBackgroundColor $panel
  DiamondBorderColor $line
}
skinparam swimlane {
  BorderColor $retiredBorder
  TitleFontStyle bold
}
