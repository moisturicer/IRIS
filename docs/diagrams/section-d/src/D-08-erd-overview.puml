@startuml
!include ../iris-style.puml
hide methods
skinparam LineType ortho
skinparam nodesep 6
skinparam ranksep 30
title D-8  Data model overview: domains and the links between them
caption Generated from the Django models on main (IR-1021). Edge labels: number of foreign keys from one app's tables to the other's.\n109 Django tables in 10 apps, plus 16 in the iris_ai schema. Solid arrow: foreign keys (count). Dashed: an id held without a DB constraint.
top to bottom direction
rectangle "<b>accounts</b> (20 tables, D-9)\n<size:10>AccountDeletionRequest, AdviserProfile</size>\n<size:10>College, Course + 16 more</size>" as accounts
rectangle "<b>ai</b> (28 tables, D-13a, D-13b)\n<size:10>AskRun, AskRunAttempt</size>\n<size:10>AskRunEvent, ChatSubmission + 24 more</size>" as ai
rectangle "<b>audit</b> (1 table, D-15)\n<size:10>AuditEvent</size>" as audit
rectangle "<b>documents</b> (10 tables, D-12)\n<size:10>DocumentRequest, DocumentRequestItem</size>\n<size:10>ExtractionFigure, ManuscriptMetadata + 6 more</size>" as documents
rectangle "<b>library</b> (2 tables, D-15)\n<size:10>SavedFeed, SavedRecord</size>" as library
rectangle "<b>notifications</b> (3 tables, D-15)\n<size:10>Notification, NotificationRead</size>\n<size:10>NotificationType</size>" as notifications
rectangle "<b>opportunities</b> (1 table, D-15)\n<size:10>Opportunity</size>" as opportunities
rectangle "<b>publication</b> (2 tables, D-12)\n<size:10>ManuscriptInvalidation, ManuscriptWork</size>" as publication
rectangle "<b>records</b> (24 tables, D-10a, D-10b)\n<size:10>Author, AuthorRole</size>\n<size:10>Classification, Conference + 20 more</size>" as records
rectangle "<b>reviews</b> (18 tables, D-11)\n<size:10>DeadlineMoment, Extension</size>\n<size:10>Holiday, RecordAssignment + 14 more</size>" as reviews
rectangle "<b>iris_ai schema</b> (AI runtime, 16 tables, D-14a, D-14b)\n<size:10>conversation, ask_run, turn, citation, …</size>" as iris_ai <<ai>>
ai --> accounts : 5
ai --> records : 11
audit --> accounts : 1
audit --> records : 1
documents --> accounts : 4
documents --> records : 6
documents --> reviews : 2
library --> accounts : 2
library --> records : 1
notifications --> accounts : 4
notifications --> records : 1
opportunities --> accounts : 1
publication --> records : 1
records --> accounts : 20
