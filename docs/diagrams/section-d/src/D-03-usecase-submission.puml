@startuml
!include ../iris-style.puml
skinparam LineType splines
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #0369A1
}
left to right direction
title D-3  Use cases: submission and versions
caption From RecordViewSet actions and apps/documents on main (IR-1021). Authors are Students and Advisers (access.ts AUTHORS).

actor "Author\n(Student or Adviser)" as Author
actor RDCO
actor "Manuscript reader\n(LlamaParse)" as LP <<external>>

rectangle "Submission and versions" {
  usecase "Publish a record: metadata, authors,\nAdviser, IP type, manuscript PDF" as UC1
  usecase "Accept title and abstract suggestions\nread from the PDF" as UC2
  usecase "Upload supporting documents\nto the record's slots" as UC3
  usecase "Answer a document request" as UC4
  usecase "Submit a new Version\nafter a revision request" as UC5
  usecase "Reply to review threads" as UC6
  usecase "Name the Contact person" as UC7
  usecase "Request deletion of a record" as UC8
  usecase "Import legacy records\nfrom an Excel template" as UC9
  usecase "Replace the Adviser, add an owner,\nwithdraw a paper in review" as UC10
  usecase "Extract the manuscript's text\nand structure" as UC11 <<ai>>
}

Author --> UC1
Author --> UC3
Author --> UC4
Author --> UC5
Author --> UC6
Author --> UC7
Author --> UC8
UC1 ..> UC2 : <<extend>>
UC1 ..> UC11 : <<include>>
UC5 ..> UC11 : <<include>>
UC11 --> LP
RDCO --> UC9
RDCO --> UC10

note bottom of UC11 : Runs in a background worker;\nonly papers the consent and embargo\ngate permits leave the campus (ADR-056)
@enduml
