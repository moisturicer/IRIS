@startuml
!include ../iris-style.puml
skinparam LineType polyline
title D-16  Deployment architecture (production)
caption From docker-compose.prod.yml, deploy/caddy/Caddyfile, frontend/nginx.conf and deploy/aws/iris-demo.yaml on main (IR-1021). Only Caddy publishes ports.

actor "Browser" as browser
cloud "Internet" as net

node "AWS EC2 instance (Ubuntu 24.04, Docker Compose)" as ec2 {
  component "caddy\n<size:10>TLS 1.2/1.3, ports 80 and 443</size>" as caddy
  component "frontend (nginx)\n<size:10>React build, /api proxy,</size>\n<size:10>runtime edge with auth_request</size>" as nginx
  component "backend\n<size:10>Django 5 + DRF, Gunicorn</size>\n<size:10>with Uvicorn workers (ASGI)</size>" as django
  component "migrate\n<size:10>runs once before the others</size>" as migrate
  component "celery-default" as cdef
  component "celery-extraction\n<size:10>concurrency 2</size>" as cext
  component "celery-embedding\n<size:10>concurrency 4</size>" as cemb
  component "celery-beat\n<size:10>scheduled jobs, Manila time</size>" as beat
  component "ai-gateway\n<size:10>FastAPI, no public port</size>" as gw <<ai>>
  component "ai-runs-worker\n<size:10>python -m ai.runs.worker</size>" as rw <<ai>>
  database "db\n<size:10>PostgreSQL 16 + pgvector</size>\n<size:10>Django tables + iris_ai schema</size>" as db
  queue "redis\n<size:10>Celery broker, cache,</size>\n<size:10>run wake-ups</size>" as redis
  storage "media_files volume\n<size:10>uploaded manuscripts</size>" as media
}

rectangle "LlamaParse\n<size:10>manuscript extraction</size>" as llp <<external>>
rectangle "Voyage AI\n<size:10>embedding, rerank</size>" as voy <<external>>
rectangle "Language model\n<size:10>OpenAI-compatible endpoint</size>\n<size:10>(OpenRouter)</size>" as llm <<external>>
rectangle "SMTP email" as smtp <<external>>
rectangle "DuckDNS\n<size:10>iris-citu.duckdns.org</size>" as dns <<external>>

browser --> net : HTTPS
net --> caddy
dns ..> caddy : name
caddy --> nginx : HTTP, internal
nginx --> django : /api/, /static/,\nedge-grant check
nginx --> gw : /api/v1/ai/runtime/…\n+ service secret
django --> db
django --> redis
migrate --> db
cdef --> db
cext --> db
cemb --> db
beat --> redis
cdef --> redis
cext --> redis
cemb --> redis
django --> media
cext --> media
gw --> db : iris_ai, as iris_ai_runtime
gw --> redis : wake workers
rw --> db
rw --> redis
cext --> llp
cemb --> voy
cemb --> llm : AI Overview
rw --> voy : query embedding
rw --> llm : answers
cdef --> smtp

legend right
  Blue: IRIS service · green: AI runtime · yellow: external service
  Every container rotates its logs (10 MB × 3); restart policy brings services back after a reboot
endlegend
@enduml
