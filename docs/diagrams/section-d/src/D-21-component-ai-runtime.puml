@startuml
!include ../iris-style.puml
skinparam LineType ortho
skinparam nodesep 8
skinparam ranksep 28
title D-21  AI runtime classes: ports and adapters
caption From ai/ on main (IR-1021): api/, runs/, agent/, research/, admission/, domain/ports.py and infrastructure/. ADR-014, ADR-049.\nDashed arrow with hollow head: implements the port. Muted classes: test doubles (recording and fake adapters).
show methods
skinparam class<<test>> {
  BackgroundColor #F1F5F9
  HeaderBackgroundColor #F1F5F9
  BorderColor #94A3B8
  FontColor #64748B
}

package "api (FastAPI routes)" {
  class "runs.py" as api <<ai>> {
    POST /runs, GET /runs/{id}
    cancel, retry, conversations
  }
}
package "runs" {
  class RunService <<ai>> {
    submit()
    retry()
    run_next()
    execute()
  }
  class RunStore <<ai>> {
    admit() / claim_next()
    save_checkpoint()
    commit_final() / fail()
    status() / reopen()
  }
  class "worker.py" as worker <<ai>> {
    claims queued runs
  }
}
package "agent" {
  class AgentExecutor <<ai>> {
    bounded tool loop
    one repair
  }
  class "checkpoint, compaction,\ncontext, assurance" as agentparts <<ai>>
}
package "research" {
  class ResearchTools <<ai>> {
    search (hybrid)
    open_passage / read_page
    outline / read_manuscript
    resolve_papers / count_records
  }
}
package "admission" {
  class AdmittedAgentProvider <<ai>> {
    reserve, recheck, settle
  }
}
package "domain (ports)" {
  abstract class LLMProvider {
    {abstract} generate_response()
    converse()
    capacity()
  }
  abstract class EmbeddingProvider {
    {abstract} embed_documents()
    {abstract} embed_query()
  }
}
package "infrastructure (adapters)" {
  class OpenAICompatibleAgentProvider
  class OpenAILLMProvider
  class OpenAIEmbeddingProvider
  class RecordingAgentProvider <<test>>
  class DeterministicFakeEmbeddingProvider <<test>>
}
class "PostgreSQL iris_ai schema" as db <<ref>>

OpenAICompatibleAgentProvider -[hidden]down- RecordingAgentProvider
OpenAIEmbeddingProvider -[hidden]down- DeterministicFakeEmbeddingProvider

api --> RunService
worker --> RunService
RunService --> RunStore
RunService --> AgentExecutor
AgentExecutor --> ResearchTools
AgentExecutor --> agentparts
AgentExecutor --> AdmittedAgentProvider
AdmittedAgentProvider ..|> LLMProvider
AdmittedAgentProvider --> OpenAICompatibleAgentProvider : wraps
OpenAICompatibleAgentProvider ..|> LLMProvider
OpenAILLMProvider ..|> LLMProvider
RecordingAgentProvider ..|> LLMProvider
OpenAIEmbeddingProvider ..|> EmbeddingProvider
DeterministicFakeEmbeddingProvider ..|> EmbeddingProvider
RunStore --> db
ResearchTools --> db : under the reader's grant

@enduml
