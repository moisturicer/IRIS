@startuml
!include ../iris-style.puml
hide methods
skinparam LineType ortho
title D-14  AI runtime schema (iris_ai): runs, conversations and indexing
caption Generated from ai/runs/migrations/*.sql on main (IR-1021). Owned by the AI runtime; Django never writes it (ADR-049).
package "iris_ai" {
  class "conversation" as ia_conversation <<ai>> {
    <b>id</b> : PK
    reader_id : Django id, no DB constraint
    scope_record_id : Django id, no DB constraint
    revision : integer
    created_at : timestamptz
    deleted_at : timestamptz
    state : jsonb
  }
  class "ask_run" as ia_ask_run <<ai>> {
    <b>id</b> : PK
    reader_id : Django id, no DB constraint
    conversation_id : FK → conversation
    turn_id : FK → turn
    retry_of : FK → ask_run
    request_key : text
    request_hash : text
    question : text
    base_revision : integer
    <i>… 15 more columns</i>
  }
  class "turn" as ia_turn <<ai>> {
    <b>id</b> : PK
    conversation_id : FK → conversation
    run_id : FK → ask_run
    ordinal : integer
    question : text
    answer : text
    created_at : timestamptz
    <i>… 3 more columns</i>
  }
  class "citation" as ia_citation <<ai>> {
    <b>turn_id</b> : PK, FK → turn
    <b>position</b> : PK
    record_id : Django id, no DB constraint
    page : integer
    quote : text
    revision : text
  }
  class "run_event" as ia_run_event <<ai>> {
    <b>run_id</b> : PK, FK → ask_run
    <b>sequence</b> : PK
    name : text
    data : jsonb
    created_at : timestamptz
  }
  class "attempt_accounting" as ia_attempt_accounting <<ai>> {
    <b>id</b> : PK
    run_id : uuid
    fence : bigint
    executor : text
    reserved_units : bigint
    <i>… 3 more columns</i>
  }
  class "research_handle" as ia_research_handle <<ai>> {
    <b>handle</b> : PK
    run_id : FK → ask_run
    record_id : Django id, no DB constraint
    chunk_set_id : Django id, no DB constraint
    chunk_id : Django id, no DB constraint
    expires_at : timestamptz
    created_at : timestamptz
  }
  class "manuscript_receipt" as ia_manuscript_receipt <<ai>> {
    <b>work_id</b> : PK
    record_id : Django id, no DB constraint
    revision : uuid
    acknowledged_at : timestamptz
    authority_generation : bigint
  }
  class "manuscript_invalidation_receipt" as ia_manuscript_invalidation_receipt <<ai>> {
    <b>event_id</b> : PK
    acknowledged_at : timestamptz
  }
  class "extraction_job" as ia_extraction_job <<ai>> {
    <b>work_id</b> : PK
    <b>pipeline</b> : PK
    generation : bigint
    attempt : uuid
    state : text
    lease_until : timestamptz
    <i>… 1 more columns</i>
  }
  class "extraction_revision" as ia_extraction_revision <<ai>> {
    <b>work_id</b> : PK
    <b>pipeline</b> : PK
    record_id : Django id, no DB constraint
    revision : uuid
    payload : jsonb
    created_at : timestamptz
  }
  class "index_job" as ia_index_job <<ai>> {
    <b>id</b> : PK
    record_id : Django id, no DB constraint
    space_id : Django id, no DB constraint
    work_id : uuid
    revision : uuid
    generation : bigint
    pipeline : text
    <i>… 8 more columns</i>
  }
  class "embedding_batch" as ia_embedding_batch <<ai>> {
    <b>job_id</b> : PK, FK → index_job
    <b>ordinal</b> : PK
    vectors : jsonb
    reservation_id : bigint
  }
  class "active_source" as ia_active_source <<ai>> {
    <b>record_id</b> : PK
    job_id : FK → index_job
  }
  class "run_checkpoint" as ia_run_checkpoint <<ai>> {
    <b>run_id</b> : PK, FK → ask_run
    fence : bigint
    step : integer
    body : jsonb
    saved_at : timestamptz
  }
  class "conversation_handoff" as ia_conversation_handoff <<ai>> {
    <b>conversation_id</b> : PK, FK → conversation
    <b>revision</b> : PK
    run_id : FK → ask_run
    fence : bigint
    base_revision : integer
    through_ordinal : integer
    turns : integer[]
    <i>… 6 more columns</i>
  }
}
class "User\n<size:9>(accounts, Django)</size>" as dj_user <<ref>>
class "Record\n<size:9>(records, Django)</size>" as dj_record <<ref>>
ia_ask_run }o--|| ia_conversation
ia_ask_run }o--o| ia_turn
ia_ask_run }o--o| ia_ask_run
ia_turn }o--|| ia_conversation
ia_turn }o--|| ia_ask_run
ia_citation |o--|| ia_turn
ia_run_event |o--|| ia_ask_run
ia_research_handle }o--|| ia_ask_run
ia_embedding_batch |o--|| ia_index_job
ia_active_source }o--|| ia_index_job
ia_run_checkpoint |o--|| ia_ask_run
ia_conversation_handoff |o--|| ia_conversation
ia_conversation_handoff }o--|| ia_ask_run
ia_conversation ..> dj_user : reader_id
ia_conversation ..> dj_record
ia_ask_run ..> dj_user : reader_id
ia_citation ..> dj_record
ia_research_handle ..> dj_record
ia_manuscript_receipt ..> dj_record
ia_extraction_revision ..> dj_record
ia_index_job ..> dj_record
ia_active_source ..> dj_record
legend right
  <b>Notation</b> (crow's foot)
  three-pronged end: many · bar: exactly one · circle: zero allowed
  PK primary key · FK foreign key · M2M many-to-many
  grey box: entity drawn in full on another diagram
  dashed arrow: Django id held without a DB constraint
endlegend
@enduml
