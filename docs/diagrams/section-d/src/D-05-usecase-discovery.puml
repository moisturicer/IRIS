@startuml
!include ../iris-style.puml
skinparam LineType splines
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #0369A1
}
left to right direction
title D-5  Use cases: discovery and reading
caption From frontend routes (/, /records/:id, /records/mine, /people/:id, /opportunities) and records/library views on main (IR-1021).

actor "Signed-in user" as User
actor RDCO
actor "Adviser or RDCO" as Poster

rectangle "Discovery and reading" {
  usecase "Search and filter Discover" as UC1
  usecase "Save a feed; read For you" as UC2
  usecase "Open a paper in Paper View" as UC3
  usecase "Find in the paper; follow\na citation to its page" as UC4
  usecase "Read the AI Overview" as UC5 <<ai>>
  usecase "See related research" as UC6
  usecase "Save to My Library\nwith a reading status" as UC7
  usecase "Comment on a published paper" as UC8
  usecase "Search people; open a profile" as UC9
  usecase "Request a download" as UC10
  usecase "Approve, decline or revoke\na download request" as UC11
  usecase "Browse Calls & Conferences" as UC12
  usecase "Post a call for papers" as UC13
}

User --> UC1
User --> UC2
User --> UC3
User --> UC7
User --> UC8
User --> UC9
User --> UC10
User --> UC12
UC3 ..> UC4 : <<extend>>
UC3 ..> UC5 : <<extend>>
UC3 ..> UC6 : <<extend>>
RDCO --> UC11
Poster --> UC13

note bottom of UC10 : Reading stays open; a download needs\nRDCO approval (ADR-048)
@enduml
