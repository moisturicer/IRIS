@startuml
!include ../iris-style.puml
skinparam LineType ortho
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #0369A1
}
left to right direction
title D-6  Use cases: Ask IRIS and Paper Chat
caption From frontend RuntimeReader, apps/ai grants and the ai/ runtime on main (IR-1021). Research roles only (access.ts RESEARCH_ROLES).

actor "Researcher\n(Student, Adviser, RDCO,\nITSO, IERC, KTTO)" as R
actor "Embedding and rerank\n(Voyage)" as V <<external>>
actor "Language model\n(OpenAI-compatible endpoint)" as LLM <<external>>

rectangle "Ask IRIS and Paper Chat" {
  usecase "Ask a question across\nthe papers I may read" as UC1 <<ai>>
  usecase "Chat about one paper\n(Paper Chat)" as UC2 <<ai>>
  usecase "Read the answer with\npage citations" as UC3
  usecase "Open a cited passage\nin the paper" as UC4
  usecase "Stop, reconnect or retry a run" as UC5
  usecase "Reopen or delete\na Conversation" as UC6
  usecase "Read, rename or delete a\nConversation from before the switch" as UC7
  usecase "Search, read and count\npermitted papers" as UC8 <<ai>>
}

R --> UC1
R --> UC2
R --> UC5
R --> UC6
R --> UC7
UC1 ..> UC3 : <<include>>
UC2 ..> UC3 : <<include>>
UC3 ..> UC4 : <<extend>>
UC1 ..> UC8 : <<include>>
UC2 ..> UC8 : <<include>>
UC8 --> V
UC1 --> LLM
UC2 --> LLM

note bottom of UC8 : Every read goes through the reader's\nDjango-issued grant, checked inside\nPostgreSQL (ADR-049)
@enduml
